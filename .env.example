# Public marketing site for aiinfradecoded.com
# Copy to .env.local for local dev. .env.local is gitignored.

# Where the site is served (used for canonical links + OG metadata).
# Local dev: http://localhost:3004
# Production: https://aiinfradecoded.com
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Where the buyer-facing AgentForge app is deployed.
# The "Sign in" link in the nav and post-purchase /thanks links point here.
# Local dev: http://localhost:3003 (the agentforge-starter frontend)
# Production: https://app.aiinfradecoded.com
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Polar checkout URLs powering the /pricing CTAs.
# Get from Polar dashboard → Products → Checkout Links.
NEXT_PUBLIC_POLAR_HOBBY_URL=
NEXT_PUBLIC_POLAR_PRO_URL=
